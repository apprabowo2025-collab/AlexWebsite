<!DOCTYPE html>
<html lang="en">
<head>
  <%- include("partials/head", { title: title }) %>
</head>

<body>
  <%- include("partials/nav") %>

  <!-- HERO SECTION -->
  <main>
    <section class="hero">
      <div class="hero-content">
        <p class="eyebrow">Writer · Producer · Musician · Educator</p>

        <h1>
          Helping artists and creative teams bring music projects to life.
        </h1>

        <p class="hero-description">
          I work across songwriting, production, teaching, artist development,
          and funding proposals — supporting projects from early ideas to
          polished releases and public programmes.
        </p>

        <div class="hero-buttons">
          <a href="/contact" class="btn btn-primary">Work With Me</a>
          <a href="#projects" class="btn btn-secondary">View Projects</a>
        </div>
      </div>

      <div class="hero-image">
        <img src="/images/hero/profile.jpg" alt="Portrait of musician and creative professional">
      </div>
    </section>

    <!-- SERVICES SECTION -->
    <section class="section" id="services">
      <div class="section-header">
        <p class="eyebrow">Services</p>
        <h2>What I Do</h2>
        <p>
          Creative and strategic support for musicians, artists, schools,
          organisations, and community projects.
        </p>
      </div>

      <div class="card-grid">
        <% services.forEach(service => { %>
          <article class="card">
            <h3><%= service.title %></h3>
            <p><%= service.description %></p>
          </article>
        <% }) %>
      </div>
    </section>

    <!-- FEATURED PROJECTS SECTION -->
    <section class="section section-dark" id="projects">
      <div class="section-header">
        <p class="eyebrow">Selected Work</p>
        <h2>Projects & Experience</h2>
        <p>
          A snapshot of music, management, teaching, and proposal-based work.
        </p>
      </div>

      <div class="project-grid">
        <% featuredProjects.forEach(project => { %>
          <article class="project-card">
            <% if (project.image) { %>
              <img src="<%= project.image %>" alt="<%= project.title %>">
            <% } %>

            <div class="project-content">
              <p class="project-category"><%= project.category %></p>
              <h3><%= project.title %></h3>
              <p class="project-role"><%= project.role %></p>
              <p><%= project.description %></p>
            </div>
          </article>
        <% }) %>
      </div>

      <div class="section-footer">
        <a href="/projects" class="btn btn-secondary">See More Projects</a>
      </div>
    </section>

    <!-- MUSIC / BAND SECTION -->
    <section class="section" id="music">
      <div class="section-header">
        <p class="eyebrow">Music</p>
        <h2>Band & Music Work</h2>
        <p>
          Performance, songwriting, releases, and live music experience.
        </p>
      </div>

      <div class="music-layout">
        <div class="music-text">
          <h3>From the stage to the studio</h3>

          <p>
            My music practice informs the way I work with artists. Being active
            as a musician gives me a practical understanding of songwriting,
            performance, collaboration, and the realities of building creative work.
          </p>

          <a href="/music" class="btn btn-primary">Explore Music</a>
        </div>

        <div class="music-list">
          <% music.forEach(item => { %>
            <article class="music-card">
              <h4><%= item.title %></h4>
              <p><%= item.description %></p>

              <% if (item.link) { %>
                <a href="<%= item.link %>" target="_blank" rel="noopener noreferrer">
                  Listen / Watch
                </a>
              <% } %>
            </article>
          <% }) %>
        </div>
      </div>
    </section>

    <!-- TEACHING SECTION -->
    <section class="section section-muted" id="teaching">
      <div class="split-section">
        <div>
          <p class="eyebrow">Teaching</p>
          <h2>Workshops, lessons, and creative learning</h2>
        </div>

        <div>
          <p>
            I offer teaching and workshop support for songwriting, music production,
            performance, creative confidence, and music project development.
          </p>

          <p>
            Sessions can be shaped for individuals, schools, youth programmes,
            community groups, or artists looking to develop their craft.
          </p>
        </div>
      </div>
    </section>

    <!-- FUNDING PROPOSALS SECTION -->
    <section class="section" id="proposals">
      <div class="split-section">
        <div>
          <p class="eyebrow">Funding & Proposals</p>
          <h2>Turning creative ideas into structured proposals</h2>
        </div>

        <div>
          <p>
            I support artists and creative teams with project descriptions,
            funding applications, budgets, timelines, programme outlines,
            and impact statements.
          </p>

          <p>
            This is useful for grant applications, school programmes,
            arts initiatives, community projects, and artist development work.
          </p>
        </div>
      </div>
    </section>

    <!-- ABOUT SECTION -->
    <section class="section section-dark" id="about">
      <div class="about-layout">
        <div>
          <p class="eyebrow">About</p>
          <h2>Music-minded, project-focused.</h2>
        </div>

        <div>
          <p>
            I work at the intersection of music, writing, production, teaching,
            and creative project development. My experience as both a musician
            and project collaborator helps me understand the artistic, practical,
            and strategic sides of bringing music work into the world.
          </p>

          <a href="/files/resume.pdf" class="btn btn-secondary" download>
            Download Resume
          </a>
        </div>
      </div>
    </section>

    <!-- CONTACT CTA -->
    <section class="contact-cta" id="contact">
      <p class="eyebrow">Contact</p>

      <h2>Need help with writing, production, teaching, or a music proposal?</h2>

      <p>
        Reach out for collaborations, workshops, artist development,
        proposal support, production work, or band-related enquiries.
      </p>

      <a href="/contact" class="btn btn-primary">Get In Touch</a>
    </section>
  </main>

  <%- include("partials/footer") %>

  <script src="/js/main.js"></script>
</body>
</html>