<!DOCTYPE html>
<html lang="en">
<head>
  <%- include("partials/head", { title: title }) %>
</head>

<body class="landing-page">
  <%- include("partials/nav") %>

  <main>
    <!-- OPENING HERO -->
    <section class="opening-hero">
      <div class="hero-bg">
        <img src="/images/alex_haak.jpeg" alt="Portrait of musician and creative professional">
      </div>

      <div class="hero-overlay"></div>

      <div class="hero-inner">
        <p class="hero-kicker">Writer · Producer · Musician · Coach</p>

        <h1>
          Building music, artists, and creative careers.
        </h1>

        <h2>
          <form action="/analyze" method="POST">
            <textarea name="feedback"></textarea>
            <button type="submit">Analyze</button>
          </form>
        </h2>

        <p class="hero-copy">
          Supporting artists through music production, writing, teaching,
          creative direction, funding proposals, and artist business coaching.
        </p>

        <div class="hero-actions">
          <a href="#contact" class="btn btn-primary">Work With Me</a>
          <a href="#music" class="btn btn-outline">Listen / Watch</a>
        </div>
      </div>

      <div class="scroll-cue">
        <span>Scroll</span>
      </div>
    </section>

    <!-- ABOUT -->
    <section class="content-section reveal" id="about">
      <div class="section-label">About</div>

      <div class="section-content split">
        <h2>
          A creative operator working across music, education, and artist development.
        </h2>

        <div>
          <p>
            I work at the intersection of songwriting, production, performance,
            teaching, and music business strategy. My background as a musician
            helps me understand the creative process, while my project work helps
            artists turn ideas into structured outcomes.
          </p>

          <p>
            Whether it is building a song, shaping an artist profile, preparing
            a funding proposal, or running a workshop, my focus is helping creative
            people move from idea to execution.
          </p>
        </div>
      </div>
    </section>

    <!-- MUSIC -->
    <section class="content-section dark-section reveal" id="music">
      <div class="section-label">Music</div>

      <div class="section-header">
        <h2>Music & Performance</h2>
        <p>
          Original music, production work, live performance, songwriting credits,
          releases, and touring experience.
        </p>
      </div>

      <div class="music-grid">
        <% music.forEach(item => { %>
          <article class="music-card">
            <% if (item.image) { %>
              <img src="<%= item.image %>" alt="<%= item.title %>">
            <% } %>

            <div class="music-card-content">
              <p><%= item.type %></p>
              <h3><%= item.title %></h3>
              <p><%= item.description %></p>

              <% if (item.link) { %>
                <a href="<%= item.link %>" target="_blank" rel="noopener noreferrer">
                  Listen / Watch
                </a>
              <% } %>
            </div>
          </article>
        <% }) %>
      </div>

      <!-- SELECTED MUSIC CREDITS -->
      <div class="credits-section reveal">
        <div class="section-content split">
          <h3>Selected Credits</h3>
          <br>

          <div class="credits-list">
            <% musicCredits.forEach(credit => { %>
              <article class="credit-item">
                <p class="credit-year"><%= credit.year %></p>
                <h4><%= credit.title %></h4>
                <p class="credit-role"><%= credit.role %></p>
                <p><%= credit.description %></p>
              </article>
            <% }) %>

            <a href="/files/resume.pdf" class="btn btn-outline" download>
              Download Full Resume
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- ARTIST BUSINESS COACHING -->
    <section class="content-section reveal" id="coaching">
      <div class="section-label">Artist Business Coaching</div>

      <div class="section-content split">
        <h2>
          Helping artists think clearly about their creative direction, career, and business.
        </h2>

        <div>
          <p>
            I support emerging artists with practical guidance across positioning,
            release planning, live strategy, content direction, artist bios,
            proposal writing, and project planning.
          </p>

          <div class="service-list">
            <div>
              <h3>Artist Positioning</h3>
              <p>Clarify identity, audience, story, and creative direction.</p>
            </div>

            <div>
              <h3>Release Planning</h3>
              <p>Plan singles, campaigns, timelines, assets, and rollout strategy.</p>
            </div>

            <div>
              <h3>Funding Proposals</h3>
              <p>Shape project ideas into structured grant or sponsorship proposals.</p>
            </div>

            <div>
              <h3>Music Business Basics</h3>
              <p>Understand goals, opportunities, income streams, and next steps.</p>
            </div>
          </div>

          <a href="#contact" class="btn btn-primary">Enquire About Coaching</a>
        </div>
      </div>
    </section>

    <!-- EDUCATION -->
    <section class="content-section dark-section reveal" id="education">
      <div class="section-label">Education</div>

      <div class="section-content split">
        <h2>
          Workshops, teaching, and creative learning programmes.
        </h2>

        <div>
          <p>
            I offer education-focused support for individuals, schools, youth programmes,
            arts organisations, and community groups looking to develop music, songwriting,
            performance, and creative project skills.
          </p>

          <div class="service-list education-list">
            <div>
              <h3>Songwriting Workshops</h3>
              <p>Guided sessions on lyrics, melody, structure, storytelling, and creative confidence.</p>
            </div>

            <div>
              <h3>Music Production Lessons</h3>
              <p>Introductory or project-based support for demos, arrangement, recording, and production workflow.</p>
            </div>

            <div>
              <h3>Performance Coaching</h3>
              <p>Support for stage presence, live arrangement, rehearsal planning, and performance preparation.</p>
            </div>

            <div>
              <h3>School & Community Programmes</h3>
              <p>Custom workshops for schools, youth groups, community arts projects, and creative organisations.</p>
            </div>
          </div>

          <a href="#contact" class="btn btn-primary">Enquire About Education Work</a>
        </div>
      </div>
    </section>

    <!-- CONTACT -->
    <section class="contact-section reveal" id="contact">
      <p class="section-label">Contact</p>

      <h2>Let’s build something in music.</h2>

      <p>
        Reach out for writing, production, teaching, funding proposals,
        artist business coaching, collaborations, or music-related projects.
      </p>

      <div class="contact-links">
        <a href="mailto:Alexhaak@fastmail.fm">Alexhaak@fastmail.fm</a>
        <a href="https://www.instagram.com/alexandrh/" target="_blank" rel="noopener noreferrer">Instagram</a>
        <a href="https://soundcloud.com/alexander-haak" target="_blank" rel="noopener noreferrer">SoundCloud</a>
      </div>
    </section>
  </main>

  <script src="/js/main.js"></script>
</body>
</html>